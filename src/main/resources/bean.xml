<!-- Setter with Array of Reference -->
<beans>
	<!-- Student bean -->
	<bean id="s1" class="com.demo.model.Student">

		<property name="id" value="101" />
		<property name="name" value="Munja" />
		<property name="city" value="Pune" />
		<property name="percentage" value="85.5" />

		<!-- Array of Address references -->
		<property name="addresses">
			<list>
				<ref bean="a1" />
				<ref bean="a2" />
			</list>
		</property>

	</bean>

	<!-- Address 1 -->
	<bean id="a1" class="com.demo.model.Address">
		<property name="line1" value="ganeshApartment" />
		<property name="line2" value="maheshnagar" />
		<property name="city" value="Nashik" />
		<property name="state" value="MH" />
	</bean>

	<!-- Address 2 -->
	<bean id="a2" class="com.demo.model.Address">
		<property name="line1" value="maheshApartment" />
		<property name="line2" value="ganeshnagar" />
		<property name="city" value="Mumbai" />
		<property name="state" value="MH" />
	</bean>

</beans>